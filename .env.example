# ==============================================================================
# Environment Configuration - GEO Healthcare AI
# ==============================================================================

# Mode: "local" (Ollama / local model) or "api" (Remote fallback like Groq / Gemini / OpenAI)
LLM_PROVIDER=local

# Local Ollama Settings (Default offline setup)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M

# Optional Cloud API Fallback (Only used if local LLM is not running)
FALLBACK_API_KEY=your_api_key_here
FALLBACK_API_BASE=https://api.openai.com/v1
FALLBACK_MODEL=gpt-3.5-turbo

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Privacy Threshold & Retrieval Parameters
SIMILARITY_THRESHOLD=0.35
TOP_K_RESULTS=3
